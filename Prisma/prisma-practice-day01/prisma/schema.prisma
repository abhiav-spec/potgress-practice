
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User{
    id Int @id @default(autoincrement())
    name String
    email String @unique
    city String 
    password String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Todo {
  id Int @id @default(autoincrement())
  title String
  description String
  isCompleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

